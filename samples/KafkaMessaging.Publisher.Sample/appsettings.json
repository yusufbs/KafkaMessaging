{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "KafkaMessaging": "Debug"
    }
  },
  "Kafka": {
    "Publisher": {
      "BootstrapServers": "localhost:9092",
      "ClientId": "order-publisher-sample",
      "DefaultTopic": "orders-topic",
      "Acks": "All",
      "EnableIdempotence": true,
      "MessageTimeoutMs": 10000,
      "CompressionType": "Snappy"
    }
  }
}
